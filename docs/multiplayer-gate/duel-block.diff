+-- A fighter blocking: its blade held up across its front, the hilt in its
+-- fist, so it reads as guarding even standing still. From the side the
+-- blade stands upright before the visor, its crossguard over the fist;
+-- from the front it lies across the chest; from the back its tip and
+-- hilt show either side of the shoulders.
+local GUARD_SIDE = {
+  "..LLYYY..G",
+  ".LYYYYYY.G",
+  ".YYYYYkVVG",
+  ".YYYYYkVvG",
+  ".yYYYYYYyG",
+  "..yyyyyggg",
+  ".YSSSSSSkg",
+  ".ySSSs....",
+}
+local GUARD_FRONT = {
+  "..LLYYYY..",
+  ".LYYYYYYy.",
+  ".YkVVVVky.",
+  ".YkVVVvky.",
+  ".yYYYYYYy.",
+  "kgGGGGGGGG",
+  ".YSSSSSSY.",
+  ".ySSSSSSy.",
+}
+local GUARD_BACK = {
+  "..LLYYYY..",
+  ".LYYYYYYy.",
+  ".YYYYYYYy.",
+  ".YYYYYYYy.",
+  "GyYYYYYYyg",
+  "..yyyyyy..",
+  ".YssssssY.",
+  ".ysssssy..",
+}
+
+-- A fighter's nine blocking frames, counted as its first nine are: each
+-- view standing, stepping, and on its other step.
+local function guard(key)
+  local views = { { GUARD_SIDE, SIDE_LEGS }, { GUARD_FRONT, FRONT_LEGS }, { GUARD_BACK, FRONT_LEGS } }
+  local out = {}
+  for _, v in views do
+    table.insert(out, frame(v[1], v[2].stand, key))
+    table.insert(out, frame(v[1], v[2].step, key))
+    table.insert(out, frame(v[1], v[2].step2, key))
+  end
+  return out
+end
+
+-- The guard's glow, 8 x 18: a bright arc on the side a blocking fighter
+-- faces (facing right; its Transform turns it the way the fighter faces),
+-- bulging outward, brightest in the middle and fading to its tips. White,
+-- so its Sprite's colour tints it. A clear pixel all round it, since the
+-- sheet packs frames edge to edge and a scaled-up edge would show its
+-- neighbour.
+local function guard_glow()
+  local c = art.canvas(8, 18)
+  for y = 1, 16 do
+    for x = 1, 6 do
+      local px, py = x - 0.5, y - 0.5
+      -- Between two circles round a point to the left: a ring's slice.
+      local dx, dy = px + 6, py - 8
+      local d = math.sqrt(dx * dx + dy * dy)
+      if d >= 8.6 and d <= 11.2 then
+        local tip = 1 - math.abs(dy) / 8.2 -- 1 in the middle, 0 at the tips
+        local a = math.max(0, tip) ^ 0.6
+        -- Brightest along the ring's outer edge.
+        a *= 0.5 + 0.5 * (d - 8.6) / 2.6
+        if a > 0 then
+          c:pixel(x, y, art.rgb(255, 255, 255, level(255 * a)))
+        end
+      end
+    end
+  end
+  return c
+end
+
