@@ -0,0 +1,300 @@
+-- The block, on this machine: held, a swing from the front scores nothing
+-- (both pushed apart, the blocked sound), a swing from behind still
+-- scores, a blocker walks at half speed and cannot swing or dash, and a
+-- block lasts 1.5 s at most and then needs block let go a second. Each
+-- starts a match from the title menu, sets the fighters where it wants
+-- them (sim.set, the running world only), and drives both slots: t.input
+-- is player 1, t.input:slot(2) player 2. The numbers (block_ticks,
+-- block_rest, block_slow, speed) are read from the world, so tuning them
+-- keeps the tests green while the rules hold, but for two checks that pin
+-- the block's 1.5 seconds and its rest's one (90 and 60 ticks). The
+-- shared keyboard's R and comma, the menu's words, and the blocking look
+-- are checked here too; the touch Block button is in tests/touch.luau,
+-- blocks over a bad link in tests/online.luau, and a block's picture in
+-- tests/looks.luau.
+local duel = require("duel")
+
+return {
+  scenario "a swing at a blocker's front scores nothing: both are pushed apart and the blocked sound plays" {
+    scene = "arena", seed = 1,
+    run = function(t)
+      duel.start(t)
+      local two = t.input:slot(2)
+      -- Face to face; player 2 blocks, facing player 1, who swings.
+      duel.face_off(t, -1, 1.5)
+      two:hold("block", true)
+      t:step(1)
+      t.expect:field("@two", "Fighter.block"):gt(0)
+      t.input:tap("attack", true)
+      t:step(1)
+      t.expect:events("swing", { by = "@one" }):count():eq(1)
+      t.expect:events("blocked", { by = "@two", from = "@one" }):count():eq(1)
+      t.expect:events("point"):count():eq(0)
+      t.expect:events("sound.play", { sound = "sfx/block" }):count():eq(1)
+      t.expect:events("sound.play", { sound = "sfx/hit" }):count():eq(0)
+      t.expect:field("@arena", "Match.state"):eq("fight")
+      t.expect:field("@arena", "Match.one"):eq(0)
+      t.expect:field("@two", "Fighter.flash"):eq(0)
+      -- The blocked swing is gone, so it cannot land later.
+      t.expect:count({ has = { "Swing" } }):eq(0)
+
+      -- Pushed apart a little: each moves back, less than a hit's knockback.
+      t:step(30)
+      local one_x = duel.field(t, "@one", "Transform.pos.x")
+      local two_x = duel.field(t, "@two", "Transform.pos.x")
+      t.expect:field("@one", "Transform.pos.x"):between(-1 - 1.5, -1 - 0.4)
+      t.expect:field("@two", "Transform.pos.x"):between(0.5 + 0.4, 0.5 + 1.5)
+      t.expect:field("@one", "Fighter.push.x"):eq(0)
+      t.expect:field("@two", "Fighter.push.x"):eq(0)
+      t:log("pushed apart to " .. one_x .. " and " .. two_x)
+      t.expect:events("point"):count():eq(0)
+      t.expect:field("@arena", "Match.state"):eq("fight")
+
+      -- The same block, player 1 blocking player 2's swing.
+      two:release("block")
+      t:step(1)
+      duel.face_off(t, -1, 1.5)
+      t.input:hold("block", true)
+      t:step(1)
+      two:tap("attack", true)
+      t:step(1)
+      t.expect:events("blocked", { by = "@one", from = "@two" }):count():eq(1)
+      t.expect:events("blocked"):count():eq(2)
+      t.expect:events("point"):count():eq(0)
+      t.expect:field("@arena", "Match.two"):eq(0)
+    end,
+  },
+
+  scenario "a swing from behind scores on a blocker, and so does one once its block has run out" {
+    scene = "arena", seed = 1,
+    run = function(t)
+      duel.start(t)
+      local two = t.input:slot(2)
+      local pause = duel.get(t, "@arena").Match.pause
+      -- Player 2 in front of player 1 with its back to it, blocking.
+      duel.place(t, "@one", -1, 0, 1, 0)
+      duel.place(t, "@two", 0.5, 0, 1, 0)
+      two:hold("block", true)
+      t:step(1)
+      t.expect:field("@two", "Fighter.block"):gt(0)
+      t.input:tap("attack", true)
+      t:step(1)
+      t.expect:events("blocked"):count():eq(0)
+      t.expect:events("point", { by = 1 }):count():eq(1)
+      t.expect:field("@arena", "Match.one"):eq(1)
+      t.expect:field("@two", "Fighter.flash"):gt(0)
+      two:release("block")
+      local r = t:run_until { event = "round.started", max_frames = pause + 10 }
+      assert(r.hit, "no new round after the point")
+      -- The new round starts with no block held or resting.
+      t.expect:field("@two", "Fighter.block"):eq(0)
+      t.expect:field("@two", "Fighter.block_wait"):eq(0)
+
+      -- Facing player 1 but held past its 1.5 seconds: no block, a point.
+      local f = duel.get(t, "@two").Fighter
+      duel.face_off(t, -1, 1.5)
+      two:hold("block", true)
+      t:step(f.block_ticks + 1)
+      t.expect:field("@two", "Fighter.block"):eq(0)
+      t.input:tap("attack", true)
+      t:step(1)
+      t.expect:events("blocked"):count():eq(0)
+      t.expect:events("point", { by = 1 }):count():eq(2)
+      t.expect:field("@arena", "Match.one"):eq(2)
+    end,
+  },
+
+  scenario "a blocker walks at half speed and cannot swing or dash; let go, it can" {
+    scene = "arena", seed = 1,
+    run = function(t)
+      duel.start(t)
+      local f = duel.get(t, "@one").Fighter
+      -- Walking right for half a second while it blocks: half the way.
+      local x = duel.field(t, "@one", "Transform.pos.x")
+      t.input:hold("block", true)
+      t.input:hold("move", { 1, 0 }, 30)
+      t:step(30)
+      t.expect:field("@one", "Fighter.block"):gt(0)
+      t.expect:field("@one", "Transform.pos.x"):near(x + f.speed * f.block_slow * 30 / 60, 1e-3)
+
+      -- Attack and dash while it blocks are nothing.
+      t.input:tap("attack", true)
+      t:step(1)
+      t.input:tap("dash", true)
+      t:step(1)
+      t.expect:events("swing"):count():eq(0)
+      t.expect:events("dash"):count():eq(0)
+      t.expect:field("@one", "Fighter.block"):gt(0)
+      t.expect:count({ has = { "Swing" } }):eq(0)
+
+      -- Let go: full speed again, and it swings and dashes.
+      t.input:release("block")
+      t:step(1)
+      t.expect:field("@one", "Fighter.block"):eq(0)
+      x = duel.field(t, "@one", "Transform.pos.x")
+      t.input:hold("move", { 1, 0 }, 30)
+      t:step(30)
+      t.expect:field("@one", "Transform.pos.x"):near(x + f.speed * 30 / 60, 1e-3)
+      t.input:tap("attack", true)
+      t:step(1)
+      t.expect:events("swing", { by = "@one" }):count():eq(1)
+      t.input:tap("dash", true)
+      t:step(1)
+      t.expect:events("dash", { by = "@one" }):count():eq(1)
+
+      -- A block held through a dash starts once the dash is over.
+      t:step(f.dash_every)
+      t.input:tap("dash", true)
+      t:step(1)
+      t.expect:events("dash", { by = "@one" }):count():eq(2)
+      t.input:hold("block", true)
+      t:step(f.dash_ticks - 1)
+      t.expect:field("@one", "Fighter.dash"):gt(0)
+      t.expect:field("@one", "Fighter.block"):eq(0)
+      t:step(1)
+      t.expect:field("@one", "Fighter.dash"):eq(0)
+      t.expect:field("@one", "Fighter.block"):eq(f.block_ticks)
+    end,
+  },
+
+  scenario "a block lasts 1.5 seconds at most, then block must be let go a second before the next" {
+    scene = "arena", seed = 1,
+    run = function(t)
+      duel.start(t)
+      local f = duel.get(t, "@one").Fighter
+      t.expect:field("@one", "Fighter.block_ticks"):eq(90)
+      t.expect:field("@one", "Fighter.block_rest"):eq(60)
+
+      -- Held: it blocks from the first tick for block_ticks ticks, and on
+      -- the next it stops, held or not.
+      t.input:hold("block", true)
+      t:step(1)
+      t.expect:field("@one", "Fighter.block"):eq(f.block_ticks)
+      t:step(f.block_ticks - 1)
+      t.expect:field("@one", "Fighter.block"):eq(1)
+      t:step(1)
+      t.expect:field("@one", "Fighter.block"):eq(0)
+      t.expect:field("@one", "Fighter.block_wait"):eq(f.block_rest)
+
+      -- Still held, the rest does not count: a second later it waits as long.
+      t:step(f.block_rest)
+      t.expect:field("@one", "Fighter.block"):eq(0)
+      t.expect:field("@one", "Fighter.block_wait"):eq(f.block_rest)
+
+      -- Let go a tick short of a second, then held: no block yet, and the
+      -- rest waits while it is held.
+      t.input:release("block")
+      t:step(f.block_rest - 1)
+      t.expect:field("@one", "Fighter.block_wait"):eq(1)
+      t.input:hold("block", true)
+      t:step(5)
+      t.expect:field("@one", "Fighter.block"):eq(0)
+      t.expect:field("@one", "Fighter.block_wait"):eq(1)
+
+      -- Let go the last tick of the second: held again, it blocks at once.
+      t.input:release("block")
+      t:step(1)
+      t.expect:field("@one", "Fighter.block_wait"):eq(0)
