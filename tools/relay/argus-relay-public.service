[Unit]
Description=Argus relay for anyone: rooms for the site's Duel, behind Tailscale Funnel
After=network-online.target tailscaled.service

[Service]
# This machine only (argus relay local:7881); argus-relay-tunnel.service
# puts it on the internet with TLS as wss://relay.argusengine.org, which is
# what a page on https://argusengine.org can reach (Kevin, 2026-11-16).
# What a public relay exposes: docs/manual/releasing.md, "Running a relay".
# The binary is the release's own (tools/relay/deploy-public.sh).
ExecStart=%h/argus-relay-public/argus relay local:7881
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
