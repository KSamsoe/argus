[Unit]
Description=Argus's old public address: sends everyone to https://argusengine.org/
After=network-online.target tailscaled.service

[Service]
WorkingDirectory=%h/argus-games
# 127.0.0.1 only, for Tailscale Funnel (tailscale funnel --https=443), which
# puts it on the internet. Since 2026-10-27 the site is argusengine.org, so
# this serves no files: every GET is a 301 to the same path there
# (--redirect). docs/playtest.md has the rest.
ExecStart=/usr/bin/node %h/argus-games/serve.mjs %h/argus-games/site 8766 127.0.0.1 --redirect https://argusengine.org
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
